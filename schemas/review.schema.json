{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ia.local/schemas/review.schema.json",
  "title": "Machine-readable workflow review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decision", "summary", "confidence", "findings"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "decision": {
      "enum": ["approved", "approved_with_findings", "changes_requested", "blocked"]
    },
    "summary": { "$ref": "#/$defs/nonEmptyString" },
    "confidence": { "$ref": "#/$defs/confidence" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nullableString": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/nonEmptyString" }
      ]
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "severity": { "enum": ["critical", "high", "medium", "low"] },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "status",
        "severity",
        "autoFixEligible",
        "file",
        "line",
        "title",
        "description",
        "evidence",
        "impact",
        "suggestedCorrection",
        "acceptanceTest",
        "boundaryViolation",
        "invariantViolation"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "category": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "severity": { "$ref": "#/$defs/severity" },
        "autoFixEligible": { "type": "boolean" },
        "file": { "$ref": "#/$defs/nullableString" },
        "line": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1 }
          ]
        },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "impact": { "$ref": "#/$defs/nonEmptyString" },
        "suggestedCorrection": { "$ref": "#/$defs/nullableString" },
        "acceptanceTest": { "$ref": "#/$defs/nullableString" },
        "boundaryViolation": { "type": "boolean" },
        "invariantViolation": { "type": "boolean" }
      }
    }
  }
}
