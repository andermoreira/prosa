{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ia.local/schemas/spec.schema.json",
  "title": "Normalized approved specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "status",
    "source",
    "approval",
    "goal",
    "nonGoals",
    "acceptanceCriteria",
    "implementationNotes",
    "documentationImpact",
    "budgets",
    "execution",
    "isolation",
    "review"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/specId" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "status": { "const": "approved" },
    "source": { "$ref": "#/$defs/source" },
    "approval": { "$ref": "#/$defs/approval" },
    "goal": { "$ref": "#/$defs/nonEmptyString" },
    "nonGoals": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/acceptanceCriterion" }
    },
    "implementationNotes": {
      "type": "array",
      "items": { "$ref": "#/$defs/implementationNote" }
    },
    "documentationImpact": { "$ref": "#/$defs/documentationImpact" },
    "budgets": { "$ref": "#/$defs/budgets" },
    "execution": { "$ref": "#/$defs/execution" },
    "isolation": { "$ref": "#/$defs/isolation" },
    "review": { "$ref": "#/$defs/review" },
    "globalGates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/gateId" }
    }
  },
  "$defs": {
    "gateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "specId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "resourceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "hash", "baseSha"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "hash": { "$ref": "#/$defs/sha" },
        "baseSha": { "$ref": "#/$defs/sha" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedBy", "approvedAt", "baseSha"],
      "properties": {
        "approvedBy": { "$ref": "#/$defs/nonEmptyString" },
        "approvedAt": { "$ref": "#/$defs/nonEmptyString" },
        "baseSha": { "$ref": "#/$defs/sha" }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-[0-9]{2,}$"
        },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "implementationNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content", "approvedBy", "approvedAt", "baseSha"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^NOTE-[0-9]{2,}$"
        },
        "content": { "$ref": "#/$defs/nonEmptyString" },
        "approvedBy": { "$ref": "#/$defs/nonEmptyString" },
        "approvedAt": { "$ref": "#/$defs/nonEmptyString" },
        "baseSha": { "$ref": "#/$defs/sha" }
      }
    },
    "documentationImpact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "paths"],
          "properties": {
            "kind": { "const": "paths" },
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/path" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "justification"],
          "properties": {
            "kind": { "const": "none" },
            "justification": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ]
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nullablePositiveInteger": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "nullablePositiveNumber": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAttemptsPerStep",
        "maxAttemptsTotal",
        "maxAgentCallsPerStep",
        "maxAgentCallsTotal",
        "maxReviewCyclesPerStep",
        "maxReviewCyclesTotal",
        "maxDiagnosisCyclesPerStep",
        "maxDiagnosisCyclesTotal",
        "maxElapsedMinutesPerStep",
        "maxElapsedMinutesTotal",
        "maxEstimatedCostPerStep",
        "maxEstimatedCostTotal",
        "maxTokensPerStep",
        "maxTokensTotal"
      ],
      "properties": {
        "maxAttemptsPerStep": { "$ref": "#/$defs/positiveInteger" },
        "maxAttemptsTotal": { "$ref": "#/$defs/positiveInteger" },
        "maxAgentCallsPerStep": { "$ref": "#/$defs/positiveInteger" },
        "maxAgentCallsTotal": { "$ref": "#/$defs/positiveInteger" },
        "maxReviewCyclesPerStep": { "$ref": "#/$defs/positiveInteger" },
        "maxReviewCyclesTotal": { "$ref": "#/$defs/positiveInteger" },
        "maxDiagnosisCyclesPerStep": { "$ref": "#/$defs/positiveInteger" },
        "maxDiagnosisCyclesTotal": { "$ref": "#/$defs/positiveInteger" },
        "maxElapsedMinutesPerStep": { "$ref": "#/$defs/positiveNumber" },
        "maxElapsedMinutesTotal": { "$ref": "#/$defs/positiveNumber" },
        "maxEstimatedCostPerStep": { "$ref": "#/$defs/nullablePositiveNumber" },
        "maxEstimatedCostTotal": { "$ref": "#/$defs/nullablePositiveNumber" },
        "maxTokensPerStep": { "$ref": "#/$defs/nullablePositiveInteger" },
        "maxTokensTotal": { "$ref": "#/$defs/nullablePositiveInteger" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "autoCommit", "pullRequest", "correctionStep", "notificationResourceIds"],
      "properties": {
        "adapter": { "const": "opencode" },
        "autoCommit": { "type": "boolean" },
        "pullRequest": { "type": "boolean" },
        "correctionStep": { "const": false },
        "notificationResourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resourceId" }
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "operatingSystemSandbox", "shell", "reviewerReadOnly", "diagnosticianReadOnly"],
      "properties": {
        "strategy": { "const": "git-worktree" },
        "operatingSystemSandbox": { "const": true },
        "shell": { "const": false },
        "reviewerReadOnly": { "const": true },
        "diagnosticianReadOnly": { "const": true }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local", "final", "globalAcceptance", "freshSessions", "blockingSeverities"],
      "properties": {
        "local": { "const": true },
        "final": { "const": true },
        "globalAcceptance": { "const": true },
        "freshSessions": { "const": true },
        "blockingSeverities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "const": "critical" },
            { "const": "high" }
          ],
          "items": false
        }
      }
    }
  }
}
