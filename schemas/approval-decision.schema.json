{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ia.local/schemas/approval-decision.schema.json",
  "title": "Human approval decision input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "outcome",
    "actor",
    "justification",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "requestId": {
      "type": "string",
      "minLength": 10,
      "maxLength": 128,
      "pattern": "^approval-[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "outcome": { "enum": ["approved", "rejected"] },
    "actor": { "$ref": "#/$defs/identifier" },
    "justification": { "$ref": "#/$defs/boundedText" },
    "nextAction": { "enum": [null, "retry", "replan", "abort"] }
  },
  "oneOf": [
    {
      "properties": {
        "outcome": { "const": "approved" },
        "nextAction": { "const": null }
      }
    },
    {
      "properties": {
        "outcome": { "const": "rejected" },
        "nextAction": { "enum": ["retry", "replan", "abort"] }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    }
  }
}
